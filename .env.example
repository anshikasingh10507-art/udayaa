# GEMINI_API_KEY: Required only if future AI endpoints are added.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret used to sign session tokens (configure in production).
SESSION_SECRET="change-me-in-production"

# DB_PATH: File path for the relational SQLite database.
DB_PATH="./data/udaya.sqlite"

# OPTIONAL FUTURE SUPABASE INTEGRATION (Not required for local demo mode)
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
